{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "web-video-editor-r2-uploader-temp",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "prompt-media"
    }
  ]
}
